# Lab image: OmniVoice + FlashInfer, on top of the production image.
#
#   docker build -f llm/omnivoice/Dockerfile.flashinfer -t xcono-tts-lab:flashinfer llm
#
# omnivoice 0.2.1 on PyPI has no omnivoice/models/omnivoice_flashinfer.py; it was
# added later (k2-fsa/OmniVoice 28bc0889). Take master pinned by commit (archive
# tarball: the base image has no git), with
# --no-deps so torch/transformers/numpy stay exactly as in xcono-tts:latest.
# FlashInfer versions follow the OmniVoice README; jit-cache carries prebuilt
# kernels for cu128 (the base image has no nvcc, so no JIT compilation).
#
# Enable in the server with OMNIVOICE_FLASHINFER=on|graph (default off).

FROM xcono-tts:latest

# Constraints: if FlashInfer's deps ask for another torch/numpy/transformers the
# build fails instead of silently replacing the verified set. (It does bump
# cuda-bindings 12.9.7 -> 12.9.10, inside torch's own >=12.9.4,<13 range.)
RUN printf 'torch==2.11.0+cu128\nnumpy==2.2.6\ntransformers==5.15.1\n' > /tmp/pins.txt \
    && python3 -m pip install --no-cache-dir -c /tmp/pins.txt \
        flashinfer-python==0.6.15.post1 "flashinfer-jit-cache==0.6.15.post1+cu128" \
        --extra-index-url https://flashinfer.ai/whl/cu128/

# The commit still says version 0.2.1, so without --force-reinstall pip keeps the
# PyPI copy (no omnivoice_flashinfer.py).
RUN python3 -m pip install --no-cache-dir --no-deps --force-reinstall \
        https://github.com/k2-fsa/OmniVoice/archive/08be0b4ccbac3e13e374e86fbfead4b4cac343e2.tar.gz \
    && test -f /usr/local/lib/python3.10/dist-packages/omnivoice/models/omnivoice_flashinfer.py
